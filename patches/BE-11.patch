+package app.diagnosis.service;
+
+import app.diagnosis.domain.Diagnosis;
+import app.diagnosis.dto.DiagnosisResponse;
+import app.diagnosis.mapper.DiagnosisMapper;
+import app.diagnosis.repository.DiagnosisRepository;
+import app.parcel.domain.Parcel;
+import app.parcel.repository.ParcelRepository;
+import java.util.UUID;
+import org.springframework.stereotype.Component;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Database steps of the diagnosis flow, each in its own short transaction. Kept in a separate bean
+ * from {@link DiagnosisService} so that Spring's transaction proxy actually applies: the AI network
+ * call in the service runs between these transactions, never inside one.
+ */
+@Component
+class DiagnosisPersistence {
+
+  private final DiagnosisRepository diagnosisRepository;
+  private final ParcelRepository parcelRepository;
+  private final DiagnosisMapper diagnosisMapper;
+
+  DiagnosisPersistence(
+      DiagnosisRepository diagnosisRepository,
+      ParcelRepository parcelRepository,
+      DiagnosisMapper diagnosisMapper) {
+    this.diagnosisRepository = diagnosisRepository;
+    this.parcelRepository = parcelRepository;
+    this.diagnosisMapper = diagnosisMapper;
+  }
+
+  /** Loads an owned parcel in a read-only transaction before the AI call runs. */
+  @Transactional(readOnly = true)
+  Parcel loadOwnedParcel(UUID parcelId, UUID ownerId) {
+    return parcelRepository
+        .findByIdAndOwnerId(parcelId, ownerId)
+        .orElseThrow(() -> new DiagnosisNotFoundException("The parcel was not found."));
+  }
+
+  /** Persists a finished diagnosis in its own transaction after the AI call has returned. */
+  @Transactional
+  DiagnosisResponse save(Diagnosis diagnosis) {
+    return diagnosisMapper.toResponse(diagnosisRepository.save(diagnosis));
+  }
+}
